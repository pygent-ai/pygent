{
  "schema_version": 1,
  "providers": {
    "deepseek": {
      "display_name": "DeepSeek",
      "default_protocol": "openai_chat_completions",
      "protocols": {
        "openai_chat_completions": {
          "protocol": "openai_chat_completions",
          "base_url": "https://api.deepseek.com",
          "authentication": "bearer",
          "api_key_env": "DEEPSEEK_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "thinking": {
                "type": "object",
                "properties": {
                  "type": {"type": "string", "enum": ["enabled", "disabled"]}
                },
                "required": ["type"],
                "additionalProperties": false
              },
              "reasoning_effort": {
                "type": "string",
                "enum": ["low", "high", "max"]
              }
            },
            "additionalProperties": true
          }
        },
        "anthropic_messages": {
          "protocol": "anthropic_messages",
          "base_url": "https://api.deepseek.com/anthropic",
          "authentication": "bearer",
          "api_key_env": "DEEPSEEK_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "thinking": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {"type": {"const": "disabled"}},
                    "required": ["type"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "enabled"},
                      "budget_tokens": {"type": "integer", "minimum": 1024},
                      "display": {"type": "string", "enum": ["summarized", "omitted"]}
                    },
                    "required": ["type", "budget_tokens"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "adaptive"},
                      "display": {"type": "string", "enum": ["summarized", "omitted"]}
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                ]
              },
              "output_config": {
                "type": "object",
                "properties": {
                  "effort": {"type": "string", "enum": ["low", "medium", "high", "xhigh", "max"]}
                },
                "required": ["effort"],
                "additionalProperties": false
              },
              "service_tier": {"type": "string", "enum": ["auto", "standard_only"]},
              "stop_sequences": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "anthropic": {
      "display_name": "Anthropic",
      "default_protocol": "anthropic_messages",
      "protocols": {
        "anthropic_messages": {
          "protocol": "anthropic_messages",
          "base_url": "https://api.anthropic.com",
          "authentication": "bearer",
          "api_key_env": "ANTHROPIC_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "thinking": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {"type": {"const": "disabled"}},
                    "required": ["type"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "enabled"},
                      "budget_tokens": {"type": "integer", "minimum": 1024},
                      "display": {"type": "string", "enum": ["summarized", "omitted"]}
                    },
                    "required": ["type", "budget_tokens"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "adaptive"},
                      "display": {"type": "string", "enum": ["summarized", "omitted"]}
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                ]
              },
              "output_config": {
                "type": "object",
                "properties": {
                  "effort": {"type": "string", "enum": ["low", "medium", "high", "xhigh", "max"]}
                },
                "required": ["effort"],
                "additionalProperties": false
              },
              "service_tier": {"type": "string", "enum": ["auto", "standard_only"]},
              "stop_sequences": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "aliyun_token_plan": {
      "display_name": "Alibaba Cloud Token Plan",
      "default_protocol": "openai_chat_completions",
      "protocols": {
        "openai_chat_completions": {
          "protocol": "openai_chat_completions",
          "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
          "authentication": "bearer",
          "api_key_env": "ALIYUN_TOKEN_PLAN_OPENAI_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "enable_thinking": {"type": "boolean"},
              "preserve_thinking": {"type": "boolean"},
              "reasoning_effort": {
                "type": "string",
                "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
              },
              "thinking": {
                "type": "object",
                "properties": {
                  "type": {"type": "string", "enum": ["adaptive", "disabled"]}
                },
                "required": ["type"],
                "additionalProperties": false
              },
              "thinking_budget": {"type": "integer", "minimum": 0},
              "tool_stream": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "anthropic_messages": {
          "protocol": "anthropic_messages",
          "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic",
          "authentication": "bearer",
          "api_key_env": "ALIYUN_TOKEN_PLAN_ANTHROPIC_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "thinking": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "disabled"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "enabled"
                      },
                      "budget_tokens": {
                        "type": "integer",
                        "minimum": 1024
                      },
                      "display": {
                        "type": "string",
                        "enum": [
                          "summarized",
                          "omitted"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "budget_tokens"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "adaptive"
                      },
                      "display": {
                        "type": "string",
                        "enum": [
                          "summarized",
                          "omitted"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "output_config": {
                "type": "object",
                "properties": {
                  "effort": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                },
                "required": [
                  "effort"
                ],
                "additionalProperties": false
              },
              "service_tier": {
                "type": "string",
                "enum": [
                  "auto",
                  "standard_only"
                ]
              },
              "stop_sequences": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
