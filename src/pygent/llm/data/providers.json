{
  "schema_version": 1,
  "providers": {
    "deepseek": {
      "display_name": "DeepSeek",
      "default_protocol": "openai_chat_completions",
      "protocols": {
        "openai_chat_completions": {
          "protocol": "openai_chat_completions",
          "base_url": "https://api.deepseek.com",
          "authentication": "bearer",
          "api_key_env": "DEEPSEEK_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "thinking": {
                "type": "object",
                "properties": {
                  "type": {"type": "string", "enum": ["enabled", "disabled"]}
                },
                "required": ["type"],
                "additionalProperties": false
              },
              "reasoning_effort": {
                "type": "string",
                "enum": ["low", "high", "max"]
              }
            },
            "additionalProperties": true
          }
        },
        "anthropic_messages": {
          "protocol": "anthropic_messages",
          "base_url": "https://api.deepseek.com/anthropic",
          "authentication": "bearer",
          "api_key_env": "DEEPSEEK_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "thinking": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {"type": {"const": "disabled"}},
                    "required": ["type"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "enabled"},
                      "budget_tokens": {"type": "integer", "minimum": 1024},
                      "display": {"type": "string", "enum": ["summarized", "omitted"]}
                    },
                    "required": ["type", "budget_tokens"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "adaptive"},
                      "display": {"type": "string", "enum": ["summarized", "omitted"]}
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  }
                ]
              },
              "output_config": {
                "type": "object",
                "properties": {
                  "effort": {"type": "string", "enum": ["low", "medium", "high", "xhigh", "max"]}
                },
                "required": ["effort"],
                "additionalProperties": false
              },
              "service_tier": {"type": "string", "enum": ["auto", "standard_only"]},
              "stop_sequences": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
