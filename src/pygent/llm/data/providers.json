    "openai": {
      "display_name": "OpenAI",
      "default_protocol": "openai_responses",
      "protocols": {
        "openai_chat_completions": {
          "protocol": "openai_chat_completions",
          "base_url": "https://api.openai.com/v1",
          "authentication": "bearer",
          "api_key_env": "OPENAI_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "max_tokens": {
                "type": "integer",
                "minimum": 1
