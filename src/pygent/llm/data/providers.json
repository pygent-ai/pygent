          "authentication": "bearer",
          "api_key_env": "OPENAI_API_KEY",
          "provider_options_schema": {
            "type": "object",
            "properties": {
              "reasoning": {
                "type": "object",
                "properties": {
                  "effort": {
                    "type": "string",
                    "enum": [
                      "none",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "concise",
                      "detailed"
                    ]
                  }
                },
                "required": [
                  "effort"
                ],
                "additionalProperties": false
              },
              "store": {
                "type": "boolean"
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "parallel_tool_calls": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
